# ---- Django --------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---- PostgreSQL ----------------------------------------------------------
POSTGRES_DB=tworld
POSTGRES_USER=tworld
POSTGRES_PASSWORD=tworld
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---- Аутентификация ------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# ---- Фронтенд ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api

# ---- Почта (сброс пароля). По умолчанию письма печатаются в консоль -------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@tworld.local

# ---- Необязательное ------------------------------------------------------
MEDIA_ROOT=

# ---- Web-push (необязательно) --------------------------------------------
# Ключи генерируются командой: python manage.py generate_vapid_keys
# Без них уведомления не отправляются, всё остальное работает как обычно.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=noreply@tworld.local
