# ---- Продакшн: скопируйте в .env.prod и заполните ------------------------
# Файл .env.prod содержит секреты — в git его не кладём.

# Домен, на который смотрит A-запись DNS вашего сервера.
DOMAIN=tworld.example.ru

# Длинная случайная строка. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Пароль базы — тоже случайный.
POSTGRES_DB=tworld
POSTGRES_USER=tworld
POSTGRES_PASSWORD=

# Закрытая бета: регистрация только по коду приглашения.
REGISTRATION_INVITE_ONLY=True

# Почта для сброса пароля. Пока не настроена — письма печатаются в лог.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@tworld.example.ru
# Для реальной отправки, например через Яндекс:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=noreply@tworld.example.ru
# EMAIL_HOST_PASSWORD=

# Web-push. Ключи: docker compose ... run --rm backend python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=you@example.ru
