# Caddy сам получает и продлевает HTTPS-сертификат Let's Encrypt для DOMAIN.
# HTTPS обязателен: без него на iPhone не работают установка на экран
# «Домой», оффлайн-режим (Service Worker) и push-уведомления.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API, админка, статика админки и публичные ссылки на отчёты — в Django.
	@backend path /api/* /admin /admin/* /static/* /s/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Загрузки пользователей. Имена файлов случайные (apps/core/storage.py),
	# листинг каталогов выключен.
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# Само приложение: SPA, все неизвестные пути — на index.html.
	handle {
		root * /srv/app

		# Service Worker и манифест не кэшируются — иначе обновление
		# приложения дойдёт до телефона через сутки.
		@nocache path /sw.js /registerSW.js /manifest.webmanifest /index.html
		header @nocache Cache-Control "no-cache"

		# Файлы сборки с хэшем в имени кэшируются навсегда.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
